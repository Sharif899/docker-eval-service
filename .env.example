# Copy to .env and adjust. Never commit a real .env with secrets.
# docker compose reads .env automatically.

# Password for the Postgres user `eval` (used by both services).
POSTGRES_PASSWORD=evalpass

# Host port for the API (container always listens on 8000).
API_PORT=8000

# Host port for Postgres (container always listens on 5432).
POSTGRES_PORT=5432

# Connection string the API uses *outside* compose (local dev).
# Inside compose the api service uses its own DATABASE_URL pointing
# at the `postgres` service; this value is for running the API or
# the seed script from your own machine.
DATABASE_URL=postgresql://eval:evalpass@localhost:5432/evaldb

# Base URL the seed script talks to.
EVAL_API_URL=http://localhost:8000
